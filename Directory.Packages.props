<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!--
          Optional but useful: treat a PackageReference with an inline Version as an error,
          forcing every version to live in this file.
        -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup Label="Silk.NET (graphics, math, windowing, input)">
        <PackageVersion Include="Silk.NET.Maths" Version="2.23.0" />
        <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
        <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
        <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup Label="Image loading">
        <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    </ItemGroup>

    <ItemGroup Label="glTF model loading">
        <PackageVersion Include="SharpGLTF.Core" Version="1.0.6" />
    </ItemGroup>

    <ItemGroup Label="Networking (Riptide UDP)">
        <PackageVersion Include="RiptideNetworking.Riptide" Version="2.2.1" />
    </ItemGroup>

    <ItemGroup Label="NavMesh (Recast/Detour C# port)">
        <PackageVersion Include="DotRecast.Recast" Version="2026.1.3" />
        <PackageVersion Include="DotRecast.Detour" Version="2026.1.3" />
    </ItemGroup>

    <ItemGroup Label="Test stack (xUnit v3 + ArchUnitNET)">
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.3" />
        <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    </ItemGroup>

</Project>
