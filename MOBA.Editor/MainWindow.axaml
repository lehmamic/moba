<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MOBA.Editor.MainWindow"
        Title="MOBA Editor"
        Width="1400"
        Height="900">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right"
                Width="320"
                Background="#1F1F1F"
                BorderBrush="#0A0A0A"
                BorderThickness="1,0,0,0">
            <TextBlock Text="Inspector (placeholder)"
                       Margin="16"
                       Foreground="#999" />
        </Border>
        <Border Background="#2A2A2A">
            <TextBlock Text="Viewport (next commit)"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       FontSize="14" />
        </Border>
    </DockPanel>
</Window>
