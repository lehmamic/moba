<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:MOBA.Editor;assembly=MOBA.Editor"
        x:Class="MOBA.Editor.MainWindow"
        Title="MOBA Editor"
        Width="1400"
        Height="900">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right"
                Width="320"
                Background="#1F1F1F"
                BorderBrush="#0A0A0A"
                BorderThickness="1,0,0,0">
            <TextBlock Text="Inspector (placeholder)"
                       Margin="16"
                       Foreground="#999" />
        </Border>
        <editor:SceneViewport />
    </DockPanel>
</Window>