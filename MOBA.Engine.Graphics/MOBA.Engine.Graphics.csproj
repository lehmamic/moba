<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Backend-agnostic graphics abstractions. The concrete OpenGL backend lives in the
      sibling project MOBA.Engine.Graphics.OpenGL; this project must not reference any
      Silk.NET graphics-API package (see ADR-008).
    -->

    <ItemGroup>
        <PackageReference Include="Silk.NET.Maths" />
        <PackageReference Include="StbImageSharp" />
        <PackageReference Include="SharpGLTF.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MOBA.Engine.Core\MOBA.Engine.Core.csproj" />
    </ItemGroup>

</Project>
