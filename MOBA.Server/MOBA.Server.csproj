<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <!--
      Headless server: NO reference to Silk.NET.Windowing / Silk.NET.OpenGL / Silk.NET.Input
      and NO reference to MOBA.Engine.Graphics / MOBA.Game.Client.
    -->

    <ItemGroup>
        <ProjectReference Include="..\MOBA.Utilities\MOBA.Utilities.csproj" />
        <ProjectReference Include="..\MOBA.Engine.Core\MOBA.Engine.Core.csproj" />
        <ProjectReference Include="..\MOBA.Engine.Networking\MOBA.Engine.Networking.csproj" />
        <ProjectReference Include="..\MOBA.Game\MOBA.Game.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
          Server only needs data assets (maps, ability definitions, …); textures and
          shaders stay in the client's output dir.
        -->
        <None Include="..\assets\maps\**\*.*">
            <Link>assets\maps\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
