# Wavefront OBJ -- LoL-style terrain (first cut)
# Hand-authored for the MOBA project.
#
# Coordinate system per ADR-001: +X right, +Y up, -Z forward into scene.
# Map: 150 x 150 centred at origin (XZ in [-75, +75]).
#
# Features encoded:
#   - North and south ground slabs at Y=0
#   - Horizontal sunken river at Z in [-7, +7], bed Y=-1.0
#     with vertical banks at Z=-7 (normal +Z) and Z=+7 (normal -Z)
#   - Two raised base platforms at Y=+0.5 in opposite corners:
#     * Base 1 in the south-west-of-river quadrant: XZ in [-65, -35] x [+40, +70]
#     * Base 2 in the north-east-of-river quadrant: XZ in [+35, +65] x [-70, -40]
#     Platforms are top-quads only -- no walls. Acceptable for the
#     near-top-down default camera; from a side angle they look like
#     floating squares. Walls are a follow-up iteration.
#
# Totals: 20 positions, 28 UVs, 3 normals, 14 triangles.
#
# Conversion to glb:
#   1. Open Blender (3.x or 4.x).
#   2. File > Import > Wavefront (.obj) -> this file.
#   3. File > Export > glTF 2.0 (.glb/.gltf):
#        Format: glb (single binary file)
#        Transform: +Y up (matches our ADR-001)
#        Geometry > Materials: NO export (engine attaches grass material)
#   4. Save as assets/models/default-terrain.glb.
#
# Iteration: ask Claude to rewrite this file with different
# dimensions, river orientation, base positions; re-import, re-export.

# === Vertex positions (20) ===

# Ground / river layer
v -75    0    -75    # 1: NW corner
v  75    0    -75    # 2: NE corner
v -75    0     -7    # 3: N slab S edge, W (top of north bank)
v  75    0     -7    # 4: N slab S edge, E
v -75   -1     -7    # 5: River bed N edge, W (bottom of north bank)
v  75   -1     -7    # 6: River bed N edge, E
v -75   -1      7    # 7: River bed S edge, W (bottom of south bank)
v  75   -1      7    # 8: River bed S edge, E
v -75    0      7    # 9: S slab N edge, W (top of south bank)
v  75    0      7    # 10: S slab N edge, E
v -75    0     75    # 11: SW corner
v  75    0     75    # 12: SE corner

# Base 1 top corners (Y=+0.5), XZ in [-65, -35] x [+40, +70]
v -65  0.5    40     # 13: base1 NW
v -35  0.5    40     # 14: base1 NE
v -35  0.5    70     # 15: base1 SE
v -65  0.5    70     # 16: base1 SW

# Base 2 top corners (Y=+0.5), XZ in [+35, +65] x [-70, -40]
v  35  0.5   -70     # 17: base2 NW
v  65  0.5   -70     # 18: base2 NE
v  65  0.5   -40     # 19: base2 SE
v  35  0.5   -40     # 20: base2 SW

# === Texture coordinates (28) ===
# Ground / river-bed / base-top: UV = (X/8, Z/8) so grass tiles every 8 units.
vt -9.375 -9.375     # 1: pos 1
vt  9.375 -9.375     # 2: pos 2
vt -9.375 -0.875     # 3: pos 3
vt  9.375 -0.875     # 4: pos 4
vt -9.375 -0.875     # 5: pos 5 (same XZ as 3)
vt  9.375 -0.875     # 6: pos 6
vt -9.375  0.875     # 7: pos 7
vt  9.375  0.875     # 8: pos 8
vt -9.375  0.875     # 9: pos 9
vt  9.375  0.875     # 10: pos 10
vt -9.375  9.375     # 11: pos 11
vt  9.375  9.375     # 12: pos 12

# Wall UVs -- V driven by world Y so the texture climbs the bank vertically.
vt -9.375  0         # 13: top-W of north bank wall
vt  9.375  0         # 14: top-E of north bank wall
vt -9.375  1         # 15: bottom-W of north bank wall
vt  9.375  1         # 16: bottom-E of north bank wall
vt -9.375  0         # 17: top-W of south bank wall (V=0 at Y=0)
vt  9.375  0         # 18: top-E of south bank wall
vt -9.375  1         # 19: bottom-W of south bank wall (V=1 at Y=-1)
vt  9.375  1         # 20: bottom-E of south bank wall

# Base platform UVs (same XZ tiling)
vt -8.125  5.0       # 21: base1 NW
vt -4.375  5.0       # 22: base1 NE
vt -4.375  8.75      # 23: base1 SE
vt -8.125  8.75      # 24: base1 SW
vt  4.375 -8.75      # 25: base2 NW
vt  8.125 -8.75      # 26: base2 NE
vt  8.125 -5.0       # 27: base2 SE
vt  4.375 -5.0       # 28: base2 SW

# === Normals (3) ===
vn  0  1  0          # 1: +Y up -- ground, river bed, base tops
vn  0  0  1          # 2: +Z -- north bank wall, faces south toward river
vn  0  0 -1          # 3: -Z -- south bank wall, faces north toward river

# === Faces (14 triangles) ===
# Winding follows GroundMesh.cs CCW-from-above pattern (NW -> SW -> SE -> NE).

# North slab (NW=1, S-edge-W=3, S-edge-E=4, NE=2)
f 1/1/1 3/3/1 4/4/1
f 1/1/1 4/4/1 2/2/1

# North bank wall (top 3,4 at Y=0; bottom 5,6 at Y=-1; normal +Z)
f 3/13/2 5/15/2 6/16/2
f 3/13/2 6/16/2 4/14/2

# River bed (NW=5, SW=7, SE=8, NE=6 in XZ from above)
f 5/5/1 7/7/1 8/8/1
f 5/5/1 8/8/1 6/6/1

# South bank wall (top 9,10 at Y=0; bottom 7,8 at Y=-1; normal -Z)
f 10/18/3 8/20/3 7/19/3
f 10/18/3 7/19/3 9/17/3

# South slab (NW=9, SW=11, SE=12, NE=10)
f 9/9/1 11/11/1 12/12/1
f 9/9/1 12/12/1 10/10/1

# Base 1 top quad
f 13/21/1 16/24/1 15/23/1
f 13/21/1 15/23/1 14/22/1

# Base 2 top quad
f 17/25/1 20/28/1 19/27/1
f 17/25/1 19/27/1 18/26/1